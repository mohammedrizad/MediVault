# Database Config
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medivault?retryWrites=true&w=majority
PORT=5002

# AI Config (REQUIRED) - Google Gemini API key
API_KEY=your_gemini_api_key

# Alert System (Optional)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# AWS Rekognition Configuration (face-login; falls back to demo mode if unset/invalid)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_REKOGNITION_COLLECTION_ID=MediVaultPatients

# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# File Encryption (AES-256-CBC) - any long random string
FILE_ENCRYPTION_KEY=change_me_to_a_long_random_string

# Backend API URL
REACT_APP_API_BASE_URL=http://localhost:5002/api

# Development Settings
REACT_APP_ENV=development
